rules_version = '2';

// Workout feedback is the only thing the app stores in Firestore:
//   session_feedback/{uid}/entries/{id}  (after finishing a workout)
//   quit_feedback/{uid}/entries/{id}     (after leaving one early)
// Signed-in users write under their own uid and may read or delete their
// entries (Delete Account removes them). Users who haven't signed in write
// under "anonymous" and can't read anything back. Everything else is closed,
// including the referral programme's collections (referralUsers,
// referralCodes, referralPurchases, rewardCodes), which only the Cloud
// Functions in functions/referrals read and write.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAnonymousBucket(uid) {
      return request.auth == null && uid == 'anonymous';
    }

    function optionalNote() {
      return !('note' in request.resource.data)
          || request.resource.data.note == null
          || (request.resource.data.note is string
              && request.resource.data.note.size() <= 2000);
    }

    function validSessionFeedback() {
      let d = request.resource.data;
      return d.keys().hasOnly(['mood', 'tags', 'note', 'day_index', 'day_title',
                               'minutes', 'calories', 'created_at',
                               'client_created_at'])
          && d.mood is string && d.mood.size() <= 40
          && d.tags is list && d.tags.size() <= 20
          && d.day_index is int
          && d.day_title is string && d.day_title.size() <= 200
          && d.minutes is int && d.calories is int
          && d.created_at == request.time
          && optionalNote();
    }

    function validQuitFeedback() {
      let d = request.resource.data;
      return d.keys().hasOnly(['reason', 'reason_label', 'note', 'day_index',
                               'step_label', 'created_at', 'client_created_at'])
          && d.reason is string && d.reason.size() <= 40
          && d.reason_label is string && d.reason_label.size() <= 200
          && d.day_index is int
          && d.step_label is string && d.step_label.size() <= 200
          && d.created_at == request.time
          && optionalNote();
    }

    match /session_feedback/{uid}/entries/{entryId} {
      allow create: if (isOwner(uid) || isAnonymousBucket(uid))
                    && validSessionFeedback();
      allow read, delete: if isOwner(uid);
    }

    match /quit_feedback/{uid}/entries/{entryId} {
      allow create: if (isOwner(uid) || isAnonymousBucket(uid))
                    && validQuitFeedback();
      allow read, delete: if isOwner(uid);
    }

    // Parent docs are never written, but Delete Account tidies them up.
    match /{collection}/{uid} {
      allow delete: if (collection == 'session_feedback'
                        || collection == 'quit_feedback') && isOwner(uid);
    }
  }
}
